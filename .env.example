DB_URL=jdbc:postgresql://localhost:5432/mealtoken
DB_USERNAME=mealtoken
DB_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
COOKIE_SECURE=false

# Public URL phones use to reach the app (encoded inside the hotel QR code)
# Public address, e.g. https://meals.example.com (encoded in hotel QR codes). Empty = use the current request address.
PUBLIC_BASE_URL=
# HMAC secret for customer passes (>= 16 chars, unique per deployment)
QR_SECRET=change-me-to-a-long-random-string
# Where hotel logos are stored
UPLOAD_DIR=uploads
# Set to true on HTTPS deployments
COOKIE_SECURE=false
THYMELEAF_CACHE=true
# Optional: enable online-payment webhooks (HMAC-SHA256 of the raw body in the X-Signature header)
# APP_PAYMENT_WEBHOOK_SECRET=
# APP_PAYMENT_PROVIDER=generic
# Development only: create a demo hotel, staff, customers (password: Demo#2026pass)
SEED_DEMO_DATA=false

# --- Sign-up verification (OTP) ---
# OTP_ENABLED=true means new accounts must enter a 6 digit code before they can sign in.
OTP_ENABLED=true
# Email is configured in application.yml (Gmail nkharose.dev@gmail.com). Only the App Password is secret:
MAIL_APP_PASSWORD=
# Mobile: any SMS / WhatsApp gateway that accepts a JSON webhook {"to": "...", "message": "..."}
# OTP_SMS_WEBHOOK_URL=
# OTP_SMS_WEBHOOK_TOKEN=
